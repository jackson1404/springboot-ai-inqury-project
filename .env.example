# Copy this file to .env for your own notes only, or set these variables in IntelliJ Run Config.
# Spring Boot does not automatically read .env without extra setup.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api
SERVER_PORT=8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=spring_ai_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_DB_DDL_AUTO=update
APP_DB_SHOW_SQL=true
APP_DB_SEED_ENABLED=true

# Use a long random secret in production. Minimum 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:5173
